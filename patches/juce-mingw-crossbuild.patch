diff --git a/extras/Build/CMake/JUCEUtils.cmake b/extras/Build/CMake/JUCEUtils.cmake
index ac995f0e0c..7c940e957f 100644
--- a/extras/Build/CMake/JUCEUtils.cmake
+++ b/extras/Build/CMake/JUCEUtils.cmake
@@ -1062,10 +1062,16 @@ function(juce_enable_vst3_manifest_step shared_code_target)
 
     get_target_property(target_version_string ${shared_code_target} JUCE_VERSION)
 
-    # Use the helper tool to write out the moduleinfo.json
+    # Use the helper tool to write out the moduleinfo.json.
+    # Under MinGW cross-compilation the helper is a Windows PE, so launch it via wine.
+    if(MINGW)
+        set(_juce_vst3_helper_launcher wine)
+    else()
+        set(_juce_vst3_helper_launcher "")
+    endif()
     add_custom_command(TARGET ${target_name} POST_BUILD
         COMMAND ${CMAKE_COMMAND} -E make_directory "${product}/Contents/Resources"
-        COMMAND juce_vst3_helper
+        COMMAND ${_juce_vst3_helper_launcher} $<TARGET_FILE:juce_vst3_helper>
             -create
             -version "${target_version_string}"
             -path "${product}"
@@ -1232,9 +1238,22 @@ function(_juce_set_plugin_target_properties shared_code_target kind)
 
         _juce_add_lv2_manifest_helper_target()
 
-        add_custom_command(TARGET ${target_name} POST_BUILD
-            COMMAND juce_lv2_helper "$<TARGET_FILE:${target_name}>"
-            VERBATIM)
+        # Nella cross-build MinGW l'helper e' un eseguibile Windows: va lanciato
+        # via wine, come gia' si fa per juce_vst3_helper. Sotto wine capita
+        # pero' che non esca dopo aver scritto i manifest e resti appeso a
+        # tempo indefinito, bloccando la build: si mette un limite di tempo e
+        # si giudica dall'esistenza di manifest.ttl, non dal codice d'uscita.
+        # I manifest vengono scritti in pochi secondi: 90 s bastano con
+        # abbondanza, e -k 5 assicura che il processo venga terminato davvero.
+        if(MINGW)
+            add_custom_command(TARGET ${target_name} POST_BUILD
+                COMMAND sh -c "timeout -k 5 90 wine '$<TARGET_FILE:juce_lv2_helper>' '$<TARGET_FILE:${target_name}>' >/dev/null 2>&1 || true; test -f '${output_path}/manifest.ttl'"
+                VERBATIM)
+        else()
+            add_custom_command(TARGET ${target_name} POST_BUILD
+                COMMAND juce_lv2_helper "$<TARGET_FILE:${target_name}>"
+                VERBATIM)
+        endif()
 
         _juce_set_copy_properties(${shared_code_target} ${target_name} "${output_path}" JUCE_LV2_COPY_DIR)
     endif()
